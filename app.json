{
  "expo": {
    "name": "ARAKAN POS",
    "slug": "retail-pos-offline",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "retailpos",
    "icon": "./assets/images/icon.png",
    "platforms": ["ios", "android"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1117"
      },
      "package": "com.retailpos.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Retail POS needs camera access to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Retail POS needs access to your photos to set product images."
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Retail POS needs Bluetooth access to connect to BLE receipt/label printers."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3b0bd26d-e3fe-4883-b347-5a134b9eaceb"
      }
    }
  }
}
